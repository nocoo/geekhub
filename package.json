{
	"name": "geekhub",
	"version": "1.4.2",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"scripts": {
		"dev": "CLOUDFLARE_ENV=local vite --host 127.0.0.1",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1",
		"deploy": "bun scripts/deploy.ts",
		"cf-typegen": "wrangler types --env local --strict-vars=false",
		"typecheck": "bun run cf-typegen && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p tsconfig.test.json",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:l2": "bun scripts/run-tests.ts l2",
		"test:l3": "bun scripts/run-tests.ts l3",
		"gate:security": "bun scripts/security.ts",
		"quality": "bun run typecheck && bun run lint && bun run test:coverage && bun run build && bun run test:l2 && bun run test:l3 && bun run gate:security",
		"db:migrate": "wrangler d1 migrations apply geekhub-local --config wrangler.jsonc --local --env local --persist-to .wrangler/state",
		"db:seed": "bun scripts/seed.ts",
		"db:import": "bun scripts/import-csv.ts",
		"setup": "bun run db:migrate && bun run db:seed",
		"prepare": "husky"
	},
	"dependencies": {
		"@nocoo/basalt": "2.2.0",
		"@nocoo/next-ai": "0.4.0",
		"@tanstack/react-query": "5.104.0",
		"ai": "7.0.126",
		"cheerio": "1.2.0",
		"fast-xml-parser": "5.11.1",
		"hono": "4.13.7",
		"jose": "6.2.12",
		"lucide-react": "1.49.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"sanitize-html": "2.17.7",
		"turndown": "7.2.1",
		"turndown-plugin-gfm": "1.0.2",
		"zod": "4.6.2"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@biomejs/biome": "2.5.13",
		"@cloudflare/vite-plugin": "1.62.3",
		"@playwright/test": "1.63.0",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/react": "16.3.3",
		"@types/bun": "1.4.0",
		"@types/node": "26.6.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/sanitize-html": "2.16.1",
		"@types/turndown": "5.0.6",
		"@vitejs/plugin-react": "6.1.1",
		"@vitest/coverage-v8": "5.0.3",
		"husky": "9.1.7",
		"jsdom": "30.1.1",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "5.0.3",
		"wrangler": "4.145.0"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"esbuild",
		"workerd"
	],
	"patchedDependencies": {
		"@nocoo/next-ai@0.4.0": "patches/@nocoo%2Fnext-ai@0.4.0.patch"
	}
}
